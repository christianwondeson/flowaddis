rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function adminUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      let path = adminUserPath();
      return exists(path) ? get(path).data : {};
    }

    // Align with Nest RolesGuard: admin role + not pending/rejected
    function isAdmin() {
      let data = userDoc();
      return signedIn()
        && data.get('role', '') == 'admin'
        && !(data.get('adminStatus', '') in ['pending', 'rejected']);
    }

    function userRole() {
      return userDoc().get('role', '');
    }

    function isHotelStaff() {
      return signedIn() && userRole() in ['hotel_admin', 'hotel_staff'];
    }

    function threadPath(hotelId, threadId) {
      return /databases/$(database)/documents/hotelChats/$(hotelId)/threads/$(threadId);
    }

    function canAccessThread(hotelId, threadId) {
      let path = threadPath(hotelId, threadId);
      let data = exists(path) ? get(path).data : {};
      return exists(path) && (
        isAdmin() ||
        isHotelStaff() ||
        data.get('guestUid', '') == request.auth.uid ||
        (
          'participantUids' in data &&
          request.auth.uid in data.participantUids
        )
      );
    }

    // Rules for users collection
    match /users/{userId} {
      allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
    }

    // Rules for trips collection
    match /trips/{tripId} {
      allow read, write: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    /**
     * Hotel messaging — ops (SA↔desk) + guest (guest↔desk) + support
     * hotelChats/{hotelId}/threads/{threadId}/messages/{messageId}
     *
     * List queries must be constrained (type / guestUid) so they match these rules.
     * Desk staff may post even when the thread doc is mid-create.
     */
    match /hotelChats/{hotelId}/threads/{threadId} {
      allow read: if signedIn() && (
        isAdmin() ||
        isHotelStaff() ||
        (resource != null && resource.data.get('guestUid', '') == request.auth.uid) ||
        (resource != null && 'participantUids' in resource.data && request.auth.uid in resource.data.participantUids)
      );

      allow create, update: if signedIn() && (
        isAdmin() ||
        isHotelStaff() ||
        (
          threadId == ('guest_' + request.auth.uid) &&
          request.resource.data.guestUid == request.auth.uid &&
          request.resource.data.type == 'guest'
        ) ||
        (
          threadId == ('support_' + request.auth.uid) &&
          request.resource.data.guestUid == request.auth.uid &&
          request.resource.data.type == 'support'
        ) ||
        (threadId == 'ops' && (isAdmin() || isHotelStaff()))
      );

      match /messages/{messageId} {
        allow read: if canAccessThread(hotelId, threadId)
          || isAdmin()
          || isHotelStaff();

        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && (
            isAdmin() ||
            isHotelStaff() ||
            canAccessThread(hotelId, threadId)
          );

        allow update, delete: if false;
      }
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

